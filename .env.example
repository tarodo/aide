# Application settings
ENV=dev
LOG_LEVEL=INFO
LOG_RENDERER=console
REQUEST_ID_HEADER=X-Request-ID

# Database
DATABASE_URL=postgresql+asyncpg://aide:aide@db:5432/aide

# JWT — REQUIRED in production: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated origins; wildcard "*" only allowed in dev)
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# Initial superuser (optional)
# FIRST_SUPERUSER_EMAIL=admin@example.com
# FIRST_SUPERUSER_PASSWORD=changeme
# FIRST_SUPERUSER_FULL_NAME=Admin
